#!/bin/bash
# ============================================================
# 诗篓 —— 生命周期管理脚本
# ============================================================

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

is_running() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(head -n1 "$PID_FILE" | tr -d '[:space:]')
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        else
            rm -f "$PID_FILE"
        fi
    fi
    return 1
}

start_process() {
    if is_running; then
        log_msg "应用已在运行，跳过启动"
        return 0
    fi

    log_msg "========== 启动诗篓 =========="

    # ----- 直接使用 TRIM_APPDEST -----
    APP_CODE_DIR="${TRIM_APPDEST}/server"

    # 优先使用 .pyc，不存在则回退 .py
    if [ -f "${APP_CODE_DIR}/app.pyc" ]; then
        APP_ENTRY="app.pyc"
    elif [ -f "${APP_CODE_DIR}/app.py" ]; then
        APP_ENTRY="app.py"
    else
        log_msg "错误：找不到 app.py 或 app.pyc"
        echo "启动失败：找不到应用入口文件" > "$TRIM_TEMP_LOGFILE"
        return 1
    fi

    cd "$APP_CODE_DIR" || {
        log_msg "错误：无法进入 $APP_CODE_DIR"
        echo "启动失败：无法进入代码目录" > "$TRIM_TEMP_LOGFILE"
        return 1
    }

    mkdir -p "${TRIM_PKGVAR}"

    export TRIM_SERVICE_PORT="${TRIM_SERVICE_PORT:-5678}"
    export TRIM_PKGVAR="${TRIM_PKGVAR}"
    export TRIM_APPDEST="${TRIM_APPDEST}"
    export TRIM_APPNAME="${TRIM_APPNAME}"
    export TRIM_USERNAME="${TRIM_USERNAME}"
    export TRIM_GROUPNAME="${TRIM_GROUPNAME}"
    export PYTHONPATH="${APP_CODE_DIR}/vendor:${PYTHONPATH:-}"

    log_msg "代码目录: ${APP_CODE_DIR}"
    log_msg "监听端口: ${TRIM_SERVICE_PORT}"
    log_msg "数据目录: ${TRIM_PKGVAR}"
    log_msg "启动命令: python3 ${APP_ENTRY}"

    python3 "${APP_ENTRY}" >> "$LOG_FILE" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"

    sleep 1
    if is_running; then
        log_msg "启动成功，PID = $pid"
        return 0
    else
        log_msg "启动失败，进程未存活"
        echo "启动失败：进程意外退出，请查看 ${LOG_FILE}" > "$TRIM_TEMP_LOGFILE"
        return 1
    fi
}

stop_process() {
    log_msg "========== 停止诗篓 =========="
    if ! is_running; then
        log_msg "应用未运行，无需停止"
        return 0
    fi
    local pid=$(head -n1 "$PID_FILE" | tr -d '[:space:]')
    log_msg "正在停止 PID = $pid"
    kill -TERM "$pid" 2>/dev/null
    local count=0
    while is_running && [ $count -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done
    if is_running; then
        log_msg "优雅停止超时，强制 kill -KILL $pid"
        kill -KILL "$pid" 2>/dev/null
        sleep 1
    fi
    rm -f "$PID_FILE"
    if is_running; then
        log_msg "停止失败"
        return 1
    else
        log_msg "停止成功"
        return 0
    fi
}

status() {
    if is_running; then
        local pid=$(head -n1 "$PID_FILE" | tr -d '[:space:]')
        echo "诗篓 运行中，PID = $pid"
        return 0
    else
        echo "诗篓 未运行"
        return 3
    fi
}

case "$1" in
    start)
        start_process
        exit $?
        ;;
    stop)
        stop_process
        exit $?
        ;;
    status)
        status
        exit $?
        ;;
    *)
        echo "用法: $0 {start|stop|status}"
        exit 1
        ;;
esac